# Copy to .env and fill in. NEVER commit real credentials.
# Prefer a READ-ONLY database role for the fabric connection.

# PostgreSQL DSN used by `agent-fabric discover` and `agent-fabric serve`.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
AGENT_FABRIC_DSN=postgresql+psycopg://readonly:changeme@localhost:5432/app

# Schemas to include (comma-separated). Empty = all non-system schemas.
# AGENT_FABRIC_INCLUDE_SCHEMAS=public,sales

# Schemas to always exclude (comma-separated).
# AGENT_FABRIC_EXCLUDE_SCHEMAS=pg_catalog,information_schema

# Row caps and timeouts for the generated MCP tools.
AGENT_FABRIC_DEFAULT_SAMPLE_LIMIT=10
AGENT_FABRIC_MAX_SAMPLE_LIMIT=100
AGENT_FABRIC_QUERY_TIMEOUT_SECONDS=15

# MongoDB DSN, e.g. mongodb://readonly:changeme@localhost:27017/app
# AGENT_FABRIC_DSN=mongodb://readonly:changeme@localhost:27017/app

# Number of documents sampled per collection to infer its field schema.
# AGENT_FABRIC_MONGO_SAMPLE_SIZE=100

# Collections to include/exclude (comma-separated). Empty include = all collections.
# AGENT_FABRIC_INCLUDE_COLLECTIONS=customers,orders
# AGENT_FABRIC_EXCLUDE_COLLECTIONS=

# Path to a fabric.config.yaml settings file (see fabric.config.example.yaml).
# Lower priority than env vars/.env above; overridden by --config on the CLI.
# AGENT_FABRIC_CONFIG=fabric.config.yaml
